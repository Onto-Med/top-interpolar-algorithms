[{"version":1,"author":"top","createdAt":1715420662.517916,"entityType":"category","id":"b5b86a81-3e92-452d-9b34-5e6fa9a5035c","titles":[{"lang":"de","text":"Medizinische Befunde"},{"lang":"en","text":"Medical findings "}],"synonyms":[],"descriptions":[],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"superCategories":[{"entityType":"category","id":"72e54b67-766b-4e49-b6fa-fb97e455ac89"}]},{"version":1,"author":"top","createdAt":1685616376.906984,"entityType":"category","id":"72e54b67-766b-4e49-b6fa-fb97e455ac89","titles":[{"lang":"de","text":"Parameter"},{"lang":"en","text":"parameters"}],"synonyms":[],"descriptions":[],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"superCategories":[]},{"version":1,"author":"top","createdAt":1685616391.111756,"entityType":"category","id":"548a0178-65aa-4eff-b9ac-4f9579e2737b","titles":[{"lang":"de","text":"Diagnosen"},{"lang":"en","text":"diagnoses"}],"synonyms":[],"descriptions":[],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"superCategories":[{"entityType":"category","id":"72e54b67-766b-4e49-b6fa-fb97e455ac89"}]},{"version":6,"author":"top","createdAt":1716820139.099148,"entityType":"single_phenotype","id":"42756966-22d3-48b7-b999-57c1d5724168","titles":[{"lang":"de","text":"ICD-10-Codes"},{"lang":"en","text":"ICD-10 codes"}],"synonyms":[],"descriptions":[{"lang":"de","text":"ICD-10-Codes zur Codierung einer Hypotonie. Es wurden ICD-10-Codes ausgewählt, die für eine Hypotonie kodieren. Auf die Aufnahme des Codes G23.8 „Sonstige näher bezeichnete degenerative Krankheiten der Basalganglien inkl. Neurogene orthostatische Hypotonie“ wurde verzichtet, da die neurogene orthostatische Hypotonie nur eins der Krankheitsbilder ist, für die dieser ICD-10-Code kodiert, und somit zu unspezifisch ist."},{"lang":"en","text":"ICD-10-codes coding an hypotensia. ICD-10 codes were selected that code for hypotension. The code G23.8 \"Other specified degenerative diseases of the basal ganglia incl. neurogenic orthostatic hypotension\" was not included as neurogenic orthostatic hypotension is only one of the clinical pictures for which this ICD-10 code is coded and is therefore too unspecific."}],"codes":[{"uri":"http://fhir.de/CodeSystem/bfarm/icd-10-gm/I95.0","codeSystem":{"uri":"http://fhir.de/CodeSystem/bfarm/icd-10-gm","name":"International Classification of Diseases Version 10","shortName":"ICD10GM","externalId":"icd10gm","latest":false},"code":"I95.0","children":[],"name":"Idiopathische Hypotonie","synonyms":[]},{"uri":"http://fhir.de/CodeSystem/bfarm/icd-10-gm/I95.1","codeSystem":{"uri":"http://fhir.de/CodeSystem/bfarm/icd-10-gm","name":"International Classification of Diseases Version 10","shortName":"ICD10GM","externalId":"icd10gm","latest":false},"code":"I95.1","children":[],"name":"Orthostatische Dysregulation","synonyms":[]},{"uri":"http://fhir.de/CodeSystem/bfarm/icd-10-gm/I95.2","codeSystem":{"uri":"http://fhir.de/CodeSystem/bfarm/icd-10-gm","name":"International Classification of Diseases Version 10","shortName":"ICD10GM","externalId":"icd10gm","latest":false},"code":"I95.2","children":[],"name":"Hypotonie durch Arzneimittel","synonyms":[]},{"uri":"http://fhir.de/CodeSystem/bfarm/icd-10-gm/I95.8","codeSystem":{"uri":"http://fhir.de/CodeSystem/bfarm/icd-10-gm","name":"International Classification of Diseases Version 10","shortName":"ICD10GM","externalId":"icd10gm","latest":false},"code":"I95.8","children":[],"name":"Chronische Hypotonie","synonyms":[]},{"uri":"http://fhir.de/CodeSystem/bfarm/icd-10-gm/I95.9","codeSystem":{"uri":"http://fhir.de/CodeSystem/bfarm/icd-10-gm","name":"International Classification of Diseases Version 10","shortName":"ICD10GM","externalId":"icd10gm","latest":false},"code":"I95.9","children":[],"name":"Hypotone Kreislaufdysregulation","synonyms":[]},{"uri":"http://fhir.de/CodeSys