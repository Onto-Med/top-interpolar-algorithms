rnalId":"loinc","latest":false},"code":"89268-7","children":[],"name":"Systolic blood pressure--lying in L-lateral position","synonyms":[]},{"uri":"http://loinc.org/87741-5","codeSystem":{"uri":"http://loinc.org","name":"Logical Observation Identifier Names and Codes","shortName":"LOINC","externalId":"loinc","latest":false},"code":"87741-5","children":[],"name":"Systolic blood pressure--post exercise","synonyms":[]},{"uri":"http://loinc.org/8459-0","codeSystem":{"uri":"http://loinc.org","name":"Logical Observation Identifier Names and Codes","shortName":"LOINC","externalId":"loinc","latest":false},"code":"8459-0","children":[],"name":"BP sys--sitting","synonyms":[]},{"uri":"http://loinc.org/8460-8","codeSystem":{"uri":"http://loinc.org","name":"Logical Observation Identifier Names and Codes","shortName":"LOINC","externalId":"loinc","latest":false},"code":"8460-8","children":[],"name":"Systolic blood pressure--standing","synonyms":[]},{"uri":"http://loinc.org/8461-6","codeSystem":{"uri":"http://loinc.org","name":"Logical Observation Identifier Names and Codes","shortName":"LOINC","externalId":"loinc","latest":false},"code":"8461-6","children":[],"name":"Systolic blood pressure--supine","synonyms":[]},{"uri":"http://loinc.org/87739-9","codeSystem":{"uri":"http://loinc.org","name":"Logical Observation Identifier Names and Codes","shortName":"LOINC","externalId":"loinc","latest":false},"code":"87739-9","children":[],"name":"BP sys--W exercise","synonyms":[]}],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"superCategories":[{"entityType":"category","id":"b5b86a81-3e92-452d-9b34-5e6fa9a5035c"}],"dataType":"number","itemType":"observation","unit":"mm[Hg]"},{"version":4,"author":"Alexandr Uciteli","createdAt":1791373271.01689,"entityType":"single_restriction","id":"cb6e3d66-13a2-4d05-9b2c-7d7e81691377","titles":[{"lang":"de","text":"Mind. 3 Werte < 100 mmHg"},{"lang":"en","text":"At least 3 values < 100 mmHg"}],"synonyms":[],"descriptions":[],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"dataType":"boolean","restriction":{"type":"number","quantifier":"min","cardinality":3,"maxOperator":"<","values":[null,100]},"superPhenotype":{"entityType":"single_phenotype","id":"c17607e9-74e4-4d03-9109-8dfffffca337","titles":[{"lang":"de","text":"Blutdruck"},{"lang":"en","text":"blood pressure"}]}},{"version":2,"author":"top","createdAt":1715420617.422691,"entityType":"composite_phenotype","id":"32527e86-c824-422e-bf77-583c8a7be7f7","titles":[{"lang":"de","text":"Algorithmus 1"},{"lang":"en","text":"Algorithm 1"}],"synonyms":[],"descriptions":[{"lang":"de","text":"Dieser Algorithmus zur Identifizierung einer Hypothonie basidert lediglich auf ICD-10-Codes."},{"lang":"en","text":"This algorithm for identification of hypotensia is based exclusively on ICD-10 codes."}],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"superCategories":[{"entityType":"category","id":"d5cc28b0-1094-415d-8c5c-34f570ec2965"}],"phenotypes":[],"dataType":"boolean","expression":{"entityId":"42756966-22d3-48b7-b999-57c1d5724168","arguments":[],"values":[]}},{"version":12,"author":"top","createdAt":1788877217.47955,"entityType":"composite_phenotype","id":"a9e98f52-0fef-4387-82ff-33d73a49dbbb","titles":[{"lang":"de","text":"Algorithmus 2"},{"lang":"en","text":"Algorithm 2"}],"synonyms":[],"descriptions":[{"lang":"de","text":"Algorithmus zur Detektion von Hypotonie durch ICD-10-Codes und Blutdruckwerte, falls die Hypotonie nicht durch ICD-10-Codes beschrieben wurde. Auf der zweiten Stufe werden mit dem Kriterium „dokumentierte systolische Blutdruckwerte liegen < 100 mmHg“ alle Patient:innen mit einem entsprechend niedrigen systolischen Blutdruckwert, in deren Akte keine ICD-10-Codierungen der Hypotonie dokumentiert sind, erfasst. Dabei wird weder zwischen der Form der Hypotonie – primäre oder sekundäre (ausgelöst durch bspw. eine Arzneimitteltherapie oder eine Komorbidität) [3] – noch zwischen möglichen alternativen Erklärungen bzw. Ursachen für den niedrigen Blutdruckwert differenziert. So kann es auch zu falsch positiven Detektionen kommen.\nDa ein einzelner Blutdruckwert < 100 mmHg relativ unspezifisch ist, wird der Algorithmus erst getriggert, wenn drei Blutdruckwerte < 100 mmHg vorliegen. Mit diesem Vorgehen soll die Spezifität erhöht werden."},{"lang":"en","text":"Algorithm for the identification of hypotension by ICD-10 codes or blood pressure values, in case the hypotension is not coded with ICD-10 codes. In the second stage, the criterion \"documented systolic blood pressure values are < 100 mmHg\" is used to record all patients with a correspondingly low systolic blood pressure value in whose file no ICD-10 codes for hypotension are documented. No distinction is made between the form of hypotension - primary or secondary (triggered, for example, by drug therapy or comorbidity) [3] - or between possible alternative explanations or causes for the low blood pressure value. This can also lead to false positive detections.\nAs a single blood pressure value < 100 mmHg is relatively unspecific, the algorithm is only triggered when three blood pressure values < 100 mmHg are present. This procedure is intended to increase specificity."}],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"superCategories":[{"entityType":"category","id":"d5cc28b0-1094-415d-8c5c-34f570ec2965"}],"phenotypes":[],"dataType":"boolean","expression":{"functionId":"Or","arguments":[{"entityId":"32527e86-c824-422e-bf77-583c8a7be7f7","arguments":[],"values":[]},{"entityId":"cb6e3d66-13a2-4d05-9b2c-7d7e81691377","arguments":[],"values":[]}],"values":[]}},{"version":12,"author":"top","createdAt":1791386576.100133,"entityType":"composite_phenotype","id":"f8d4ca75-b524-4097-8da1-ff6f20acdb77","titles":[{"lang":"de","text":"Algorithmus 2A Non-Hypotonie"},{"lang":"en","text":"Algorithm 2A non-hypotension"}],"synonyms":[],"descriptions":[{"lang":"de","text":"Algorithmus zur Identifikation von Patienten, bei denen mind. ein Blutdruckwert gemessen wurde, aber keine Hypotonie bzw. keine ICD-Kodierung vorliegt. Die Rationale dahinter ist, dass möglicherweise nicht bei jedem Patienten min. 3 der Blutdruck gemessen wurde, wenn denn der Blutdruckwert bei mindestens einer Messung im Normbereich lag."},{"lang":"en","text":"Algorithm for identifying patients for whom at least one blood pressure values have been measured but who do not have hypotension or an ICD code. The reasoning behind this is that blood pressure may not have been measured at least three times for every patient, provided that the blood pressure was within the normal range on at least one occasion."}],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"superCategories":[{"entityType":"category","id":"d5cc28b0-1094-415d-8c5c-34f570ec2965"}],"phenotypes":[],"dataType":"boolean","expression":{"functionId":"And","arguments":[{"functionId":"Not","arguments":[{"entityId":"32527e86-c824-422e-bf77-583c8a7be7f7","arguments":[],"values":[]}],"values":[]},{"entityId":"03bf5701-d226-4555-89fa-332b0b288861","arguments":[],"values":[]}],"values":[]}},{"version":2,"author":"Alexandr Uciteli","createdAt":1791373583.493252,"entityType":"single_restriction","id":"54a9f5bd-0c4e-4e1c-819e-0afd64b0e747","titles":[{"lang":"de","text":"Nicht mehr als 2 Werte < 100 mmHg"},{"lang":"en","text":"No more than 2 values < 100 mmHg"}],"synonyms":[],"descriptions":[],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"dataType":"boolean","restriction":{"type":"number","quantifier":"max","cardinality":2,"maxOperator":"<","values":[null,100]},"superPhenotype":{"entityType":"single_phenotype","id":"c17607e9-74e4-4d03-9109-8dfffffca337","titles":[{"lang":"de","text":"Blutdruck"},{"lang":"en","text":"blood pressure"}]}},{"version":2,"author":"Alexandr Uciteli","createdAt":1791384101.578627,"entityType":"single_restriction","id":"d8eddd4b-cac8-4078-8c07-464c998ceadc","titles":[{"lang":"de","text":"Mind. 1 Wert ≥ 100 mmHg"},{"lang":"en","text":"At least 1 value ≥ 100 mmHg"}],"synonyms":[],"descriptions":[],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"dataType":"boolean","restriction":{"type":"number","quantifier":"min","cardinality":1,"minOperator":">=","values":[100,null]},"superPhenotype":{"entityType":"single_phenotype","id":"c17607e9-74e4-4d03-9109-8dfffffca337","titles":[{"lang":"de","text":"Blutdruck"},{"lang":"en","text":"blood pressure"}]}},{"version":3,"author":"Alexandr Uciteli","createdAt":1791384141.007987,"entityType":"composite_phenotype","id":"03bf5701-d226-4555-89fa-332b0b288861","titles":[{"lang":"de","text":"Blutdruck normal"},{"lang":"en","text":"Blood pressure normal"}],"synonyms":[],"descriptions":[{"lang":"de","text":"Gibt 'true' zurück, wenn mindestens 1 Wert vorhanden ist und alle Werte im Normbereich liegen."},{"lang":"en","text":"Returns ‘true’ if at least one value is present and all values are within the normal range."}],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"superCategories":[{"entityType":"category","id":"b5b86a81-3e92-452d-9b34-5e6fa9a5035c"}],"phenotypes":[],"dataType":"boolean","expression":{"functionId":"And","arguments":[{"entityId":"d8eddd4b-cac8-4078-8c07-464c998ceadc","arguments":[{"entityId":"c17607e9-74e4-4d03-9109-8dfffffca337","arguments":[],"values":[]}],"values":[]},{"entityId":"54a9f5bd-0c4e-4e1c-819e-0afd64b0e747","arguments":[],"values":[]}],"values":[]}},{"version":5,"author":"top","createdAt":1791386696.985243,"entityType":"composite_phenotype","id":"d7b221e3-5cde-46c2-9023-657618abd4b3","titles":[{"lang":"de","text":"Algorithmus 2B Non-Hypotonie"},{"lang":"en","text":"Algorithm 2B non-hypotension"}],"synonyms":[],"descriptions":[{"lang":"de","text":"Algorithmus zur Identifikation von Patienten, bei denen mind. drei Blutdruckwerte gemessen wurden, aber keine Hypotonie bzw. keine ICD-Kodierung vorliegt. Dieser Algorithmus stellt somit die absolute Verneinung von Algorithmus 2 dar, d.h. es müssen mindestens 3 Blutdruckwerte existieren, um eine Hypotonie feststellen bzw. in dem Fall ausschließen zu können."},{"lang":"en","text":"Algorithm for identifying patients for whom at least three blood pressure values have been measured but who do not have hypotension or an ICD code. This algorithm thus represents the exact opposite of Algorithm 2; that is, there must be at least three blood pressure measurements in order to diagnose hypotension or, in this case, to rule it out."}],"codes":[],"repository":{"id":"hypotension","name":"Hypotension","primary":true,"organisation":{"id":"polar"}},"superCategories":[{"entityType":"category","id":"d5cc28b0-1094-415d-8c5c-34f570ec2965"}],"phenotypes":[],"dataType":"boolean","expression":{"functionId":"And","arguments":[{"entityId":"f8d4ca75-b524-4097-8da1-ff6f20acdb77","arguments":[],"values":[]},{"functionId":"Ge","arguments":[{"functionId":"Count","arguments":[{"entityId":"c17607e9-74e4-4d03-9109-8dfffffca337","arguments":[],"values":[]}],"values":[]},{"arguments":[],"values":[{"dataType":"number","value":3}]}],"values":[]}],"values":[]}}]